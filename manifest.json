{
  "manifest_version": 3,
  "name": "Dearchiver",
  "version": "0.1.0",
  "description": "Open links in archive.is via context menu",
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
